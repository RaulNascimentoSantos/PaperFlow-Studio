{
  "name": "paperflow-api",
  "version": "1.0.0-mvp",
  "description": "Transform Documents into Data Intelligence - API REST que transforma PDFs em dados estruturados e insights via IA",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t paperflow-api .",
    "docker:run": "docker run -p 3000:3000 paperflow-api",
    "load:test": "k6 run tests/load/test.js",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "pdf",
    "ai",
    "document-processing",
    "rest-api",
    "typescript",
    "fastify"
  ],
  "author": "PaperFlow Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.454.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@langchain/openai": "^0.0.12",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/auto-instrumentations-node": "^0.39.0",
    "@opentelemetry/exporter-prometheus": "^0.45.1",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@types/pdf-parse": "^1.1.5",
    "bcrypt": "^5.1.1",
    "bullmq": "^4.15.4",
    "canvas": "^3.2.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.24.3",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.0.189",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^2.1.4",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "redis": "^4.6.11",
    "sharp": "^0.32.6",
    "stripe": "^14.5.0",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@docusaurus/core": "3.0.1",
    "@docusaurus/preset-classic": "3.0.1",
    "@playwright/test": "^1.40.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.9",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "k6": "0.0.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "semantic-release": "^22.0.12",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.4.0",
    "typescript": "^5.3.2"
  }
}
